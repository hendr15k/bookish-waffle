{
  "name": "web-cas",
  "version": "1.0.0",
  "description": "A lightweight, client-side Computer Algebra System (CAS) with an Xcas-like syntax",
  "homepage": "https://hendr15k.github.io/bookish-waffle/",
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "test:core": "node tests/test_core.js",
    "test:latex": "node tests/test_latex.js",
    "test:chemistry": "node tests/test_chemistry.js",
    "test:ui": "node tests/test_ui_logic.js",
    "test:extended": "node tests/test_extended.js",
    "build": "npm run build:android:web",
    "build:android:web": "node scripts/prepare-android-web.mjs",
    "cap:sync": "npm run build:android:web && npx cap sync android"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "jsdom": "^29.1.0",
    "playwright": "^1.60.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4"
  },
  "keywords": [
    "CAS",
    "computer-algebra",
    "mathematics",
    "xcas",
    "symbolic-computation",
    "ODE-solver",
    "javascript"
  ],
  "license": "MIT"
}
